{
  "name": "landingpage-postres",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "db:create": "npx sequelize-cli db:create",
    "db:seed:generate": "npx sequelize-cli seed:generate --name",
    "db:seed": "npx sequelize-cli db:seed:all",
    "db:migration:generate": "npx sequelize-cli migration:generate --name",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:migrate:undo": "npx sequelize-cli db:migrate:undo",
    "deploy": "npm install && npx sequelize-cli db:migrate && npx sequelize-cli db:seed:all && npm start",
    "start": "node src/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
